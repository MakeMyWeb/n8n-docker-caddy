# Template for the local .env file. Copy it, then fill in the real values:
#
#   cp .env.dist .env && $EDITOR .env
#
# .env is gitignored and must NEVER be committed: it holds POSTGRES_PASSWORD.
# Run `make preflight` to check the file before starting the stack.

# ---- Compose project name (container name prefix) ----
# On an already deployed host this MUST match the existing prefix.
# Check it with: docker compose ps
COMPOSE_PROJECT_NAME=n8n-docker-caddy

# ---- Routing / TLS (required) ----
DOMAIN_NAME=example.com
SUBDOMAIN=n8n
# n8n will be reachable at https://${SUBDOMAIN}.${DOMAIN_NAME}
# The Caddyfile derives its site address and its TLS certificate from these two
# variables, so there is nothing to edit in caddy_config/Caddyfile.

# Contact address for the Let's Encrypt account
SSL_EMAIL=admin@example.com

# Timezone used by default by n8n's Cron nodes
GENERIC_TIMEZONE=Europe/Paris

# ---- PostgreSQL (required) ----
# Generate the password with: make secret
# Note: the postgres image only applies POSTGRES_PASSWORD when it initialises an
# empty data directory. Changing it later also requires an ALTER USER in the
# database — see docs/DEPLOYMENT.md.
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=

# ---- Image versions (optional) ----
# Left commented out, every image resolves to `latest` and `make upgrade` pulls
# the newest release. Set them to pin versions and make deploys reproducible.
# Never lower N8N_IMAGE_TAG below the running version: n8n's database
# migrations are not reversible.
#N8N_IMAGE_TAG=latest
#CADDY_IMAGE_TAG=latest
#POSTGRES_IMAGE_TAG=16

# ---- Optional ----
# Where n8n's editor port is published on the host. Loopback by default, so n8n
# is only reachable publicly through Caddy over HTTPS. Never use 0.0.0.0 here.
#N8N_HOST_PORT=127.0.0.1:5678

# Host directory mounted at /files inside n8n. Relative paths resolve against
# this repository, not your current shell directory.
#LOCAL_FILES_PATH=./local_files

#N8N_DATA_TABLES_MAX_SIZE_BYTES=500000000

# ---- Execution retention (optional) ----
# Pruning is already ON by default in n8n; the values below ARE its defaults, so
# leaving them commented out changes nothing. They are the knobs that decide how
# large the database and the binaryData/ directory in the n8n_data volume grow —
# run `make disk` to see where the space actually goes. Lowering a value deletes
# the history beyond it permanently, on the next prune.
#EXECUTIONS_DATA_PRUNE=true
#EXECUTIONS_DATA_MAX_AGE=336              # hours; 336 = 14 days
#EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000    # 0 = no limit
#EXECUTIONS_DATA_SAVE_ON_ERROR=all        # all | none
#EXECUTIONS_DATA_SAVE_ON_SUCCESS=all      # 'none' is by far the biggest saving
#EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
